{
    "venvPath": ".",
    "venv": ".venv",
    "typeCheckingMode": "strict",
    "reportMissingImports": true,
    "reportMissingTypeStubs": false,
    // "include": [
    //     "."
    // ],
    "include": [
        "src"
    ],
    "exclude": [
        "**/__pycache__",
        "**/.venv",
        "**/venv",
        "**/env",
        "**/.env",
        "**/.*",
        "**/node_modules",
    ]
}